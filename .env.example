# PostgreSQL (должен указывать на базу marts_db)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/marts_db

# Админка /sales
ADMIN_PASSWORD=задайте_сложный_пароль
SESSION_SECRET=случайная_строка_для_подписи_cookie

# Опционально: Telegram при новой заявке
TG_BOT_TOKEN=
TG_CHAT_ID=

# Порт API и статики (для npm run dev проксирует с Vite на 3000)
PORT=3000


